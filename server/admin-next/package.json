    "bytemd": "^1.21.0",
    "compression": "^1.7.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^1.2.1",
    "dayjs": "^1.11.7",
    "express": "^4.18.2",
    "filesize": "^8.0.7",
    "jsonwebtoken": "^8.5.1",
    "lodash": "^4.17.21",
    "lucide-react": "^1.38.0",
    "md5": "^2.3.0",
    "morgan": "^1.10.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "recharts": "2.7.2",
    "tailwind-merge": "^3.6.0",
