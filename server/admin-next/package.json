    "@types/react-dom": "^18.0.11",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^4.3.4",
    "cross-env": "^7.0.3",
    "nodemon": "^2.0.22",
    "ts-node": "^10.9.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.3.3",
    "vite": "^5.4.19"
  }
