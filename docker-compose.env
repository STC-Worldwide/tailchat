LOGGER=true
LOGLEVEL=info
SERVICEDIR=services

TRANSPORTER=redis://redis:6379

REDIS_URL=redis://redis:6379
MONGO_URL=mongodb://mongo/tailchat
SECRET=

# file
# API_URL is written into uploaded-file URLs. It pointed at upstream's
# nightly host, so a local stack minted links to moonrailgun.com.
API_URL=http://localhost:11000

# minio
MINIO_URL=minio:9000
MINIO_USER=tailchat
MINIO_PASS=com.msgbyte.tailchat

# SMTP
SMTP_SENDER=
SMTP_URI=

# metrics
# server/devops/ (the only scrape target in-repo) was removed: its compose
# referenced a base path and a service that do not exist, so it could not
# start. Re-enable when a monitoring stack exists for deploy/stc.
PROMETHEUS=0

# Admin
ADMIN_USER=tailchat
ADMIN_PASS=
