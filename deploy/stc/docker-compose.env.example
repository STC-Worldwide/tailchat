# STC Tailchat environment — copy to docker-compose.env on the VPS, chmod 600.
# Then:  ln -s docker-compose.env .env
# (compose reads .env for ${...} interpolation; containers read docker-compose.env)
# NEVER commit the real file.

LOGGER=true
LOGLEVEL=info
SERVICEDIR=services

TRANSPORTER=redis://redis:6379
REDIS_URL=redis://redis:6379
MONGO_URL=mongodb://mongo/tailchat

# Public hostname. CHAT_DOMAIN drives Caddy TLS; API_URL must be https://<same host>.
CHAT_DOMAIN=chat.example.com
API_URL=https://chat.example.com

# JWT signing key — generate: openssl rand -hex 24. Never leave default.
SECRET=

# Registration requires a verified email address.
EMAIL_VERIFY=true
# Value with spaces MUST be single-quote wrapped or compose's .env parser
# rejects the file. Example:
#   SMTP_SENDER='"STC Chat" <chat@stc-worldwide.com>'
SMTP_SENDER=
# netcup blocks outbound 465/587 — use Resend's alternate port 2465. Example:
#   SMTP_URI=smtps://resend:<sending-only-api-key>@smtp.resend.com:2465
SMTP_URI=

# MinIO file storage (internal). MINIO_USER/PASS are also injected as the
# MinIO root credentials via compose interpolation — one source of truth.
MINIO_URL=minio:9000
MINIO_USER=tailchat
MINIO_PASS=

# 25 MB upload limit (default is 1 MB)
FILE_LIMIT=26214400

PROMETHEUS=1

# Admin panel at /admin/
ADMIN_USER=stcadmin
ADMIN_PASS=

# Agent API (docs/superpowers/specs/2026-09-03-tailchat-agent-api-design.md)
# Requests per minute per credential (per IP before login). 0 disables.
API_RATE_LIMIT=600
# User ids (comma-separated) allowed to grant an OpenApp the `admin`
# capability, which lets that app's API keys ban users, add members to any
# group and send system notifications. Leave empty to allow only the admin
# panel. Find an id under /admin/ -> Users.
ADMIN_USER_IDS=

# --- Users are clients of this server, and nothing more ---------------------
# Accounts are created by an admin, not self-service.
DISABLE_USER_REGISTER=1
DISABLE_GUEST_LOGIN=1
# Project groups are created by the operator; crews join, they do not create.
DISABLE_CREATE_GROUP=1
# Minting an open app hands out bot and OAuth credentials. With this on, only
# the ids in ADMIN_USER_IDS may call openapi.app.create or setAppCapability.
DISABLE_OPEN_APP_CREATE=1
# Origins a group web panel may embed, comma-separated. Empty allows NONE and
# a blocked panel says so on screen; `*` allows everything (upstream default).
#   WEBVIEW_ORIGIN_ALLOWLIST=https://docs.stc-worldwide.com,https://grafana.example.com
WEBVIEW_ORIGIN_ALLOWLIST=
# Hides the read-only "Installed plugins" page. The plugin store itself is
# gone — nothing in the browser can install anything — so this is cosmetic and
# is normally left off.
# DISABLE_PLUGIN_STORE=1
# DISABLE_ADD_FRIEND=1
